# Required by the default PostgreSQL, Redis cache, wallet encryption,
# recovery-envelope encryption, approval JWT, and AuthGuard context verifier.
# Generate every value before deployment. This is an env-file, not a shell
# script: values must be single-line and must not be quoted.
AGENTVAULT_STORAGE_POSTGRES_URL=<POSTGRES_DSN>
AGENTVAULT_CACHE_REDIS_URL=<REDIS_URL>
AGENTVAULT_WALLET_KEK_V1=<UNPADDED_BASE64URL_32_BYTES>
AGENTVAULT_RECOVERY_KEY_V1=<UNPADDED_BASE64URL_32_BYTES>
AGENTVAULT_APPROVAL_JWT_KEY_V1=<UNPADDED_BASE64URL_32_BYTES>
AUTHGUARD__AUTHZ__SCOPE_DELIVERY__DIRECT_CONTEXT_HMAC_KEY=<SAME_VALUE_AS_AUTHGUARD_SECRET>

# Required only when MQTT is enabled.
# AGENTVAULT_MQTT_PASSWORD=<MQTT_PASSWORD>

# Optional protocol/provider secrets follow the SecretRef.env names selected in
# agentvault.yaml. Wallet provisioning private keys may also be supplied here;
# use a dedicated, narrowly scoped variable for each wallet.
# AGENTVAULT_MPP_CHALLENGE_SECRET=<MPP_CHALLENGE_SECRET>
# AGENTVAULT_PROVIDER_AUTH_TOKEN=<PROVIDER_AUTH_TOKEN>
# AGENTVAULT_PROVISION_WALLET_PRIMARY_KEY=<HEX_EOA_PRIVATE_KEY>
