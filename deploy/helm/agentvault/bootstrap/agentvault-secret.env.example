# Required by the default PostgreSQL, Redis cache, wallet encryption,
# recovery-envelope encryption, approval JWT, and AuthGuard context verifier.
# Generate every value before deployment. This is an env-file, not a shell
# script: values must be single-line and must not be quoted.
# Sensitive leaves use the same canonical field path as agentvault.yaml. The
# daemon excludes these values from AppConfig and resolves them only through
# the corresponding SecretRef.
AGENTVAULT__STORAGE__POSTGRES__URL=<POSTGRESQL_URL>
AGENTVAULT__CACHE__REDIS__URLS=<REDIS_URL>
AGENTVAULT__AGENTVAULT__KEY_MANAGEMENT__KEYS__WALLET_KEK_V1=<UNPADDED_BASE64URL_32_BYTES>
AGENTVAULT__AGENTVAULT__RECOVERY_ENCRYPTION__KEYS__RECOVERY_V1=<UNPADDED_BASE64URL_32_BYTES>
AGENTVAULT__AGENTVAULT__APPROVAL__JWT__SIGNING_KEYS__APPROVAL_HS256_V1=<UNPADDED_BASE64URL_32_BYTES>
AGENTVAULT__SERVER__AUTHGUARD__DIRECT_CONTEXT_HMAC_KEY=<SAME_VALUE_AS_AUTHGUARD_SECRET>

# Required only when MQTT is enabled.
# AGENTVAULT__AGENTVAULT__TRANSPORT__MQTT__PASSWORD=<MQTT_PASSWORD>

# Optional protocol/provider secrets follow the SecretRef.env names selected in
# agentvault.yaml. Console-import wallet private keys may also be supplied here;
# use a dedicated, narrowly scoped variable for each wallet.
# AGENTVAULT__AGENTVAULT__PAYEE__MPP__CHALLENGE_SECRET=<MPP_CHALLENGE_SECRET>
# AGENTVAULT__AGENTVAULT__PAYEE__X402__FACILITATOR__SECRET_HEADERS__AUTHORIZATION__SOURCE=<PROVIDER_AUTH_TOKEN>
# Wallet resource documents own their private_key_env names; those are command
# inputs rather than agentvault.yaml fields and should remain narrowly scoped.
