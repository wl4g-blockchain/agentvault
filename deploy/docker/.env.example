# Copy to .env and replace every placeholder. No production secret has a
# repository default.
AGENTVAULT_POSTGRES_PASSWORD=<AGENTVAULT_POSTGRES_PASSWORD>
AGENTVAULT_STORAGE_POSTGRES_URL=postgres://agentvault:<AGENTVAULT_POSTGRES_PASSWORD>@agentvault-postgres:5432/agentvault
AGENTVAULT_CACHE_REDIS_URL=redis://:<AGENTVAULT_REDIS_PASSWORD>@agentvault-redis:6379/0
AGENTVAULT_REDIS_PASSWORD=<AGENTVAULT_REDIS_PASSWORD>
AGENTVAULT_WALLET_KEK_V1=<BASE64URL_32_BYTE_KEY>
AGENTVAULT_RECOVERY_KEY_V1=<BASE64URL_32_BYTE_KEY>
AGENTVAULT_APPROVAL_JWT_KEY_V1=<BASE64URL_32_BYTE_KEY>

# This exact value is shared by AuthGuard AuthZ and the AgentVault workload
# adapter. Use at least 32 random bytes.
AUTHGUARD__AUTHZ__SCOPE_DELIVERY__DIRECT_CONTEXT_HMAC_KEY=<AT_LEAST_32_RANDOM_BYTES>
AUTHGUARD__STORAGE__POSTGRES__PASSWORD=<AUTHGUARD_POSTGRES_PASSWORD>
AUTHGUARD__CACHE__REDIS__PASSWORD=<AUTHGUARD_REDIS_PASSWORD>
AUTHGUARD__AUTHZ__API__TOKEN=<AUTHGUARD_API_TOKEN>
AUTHGUARD__AUTHN__TOKEN__PRIVATE_KEY_B64=<BASE64_PKCS8_RSA_PRIVATE_KEY_PEM>
AUTHGUARD__AUTHN__STANDALONE__ENABLED=true
AUTHGUARD__AUTHN__STANDALONE__CREDENTIAL_ENCRYPTION_KEY=<BASE64_32_BYTE_AES_KEY>
AUTHGUARD__AUTHN__STANDALONE__TOTP__ENABLED=true
AUTHGUARD__AUTHN__STANDALONE__WEBAUTHN__ENABLED=true
AUTHGUARD__AUTHN__STANDALONE__WEBAUTHN__RP_ID=localhost
AUTHGUARD__AUTHN__STANDALONE__WEBAUTHN__RP_ORIGIN=http://localhost:8080

AGENTVAULT_IMAGE=ghcr.io/wl4g/agentvault:0.1.0
AGENTVAULT_WEB_IMAGE=ghcr.io/wl4g/agentvault-web:0.1.0
AUTHGUARD_IMAGE=ghcr.io/wl4g/authguard:1.0.1
AUTHGUARD_WEB_IMAGE=ghcr.io/wl4g/authguard-web:1.0.1
