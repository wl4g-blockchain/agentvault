# Copy to .env and replace every placeholder. No production secret has a
# repository default.
# AgentVault runtime overrides always use the canonical YAML field path.
AGENTVAULT__SERVER__ENABLED=true
AGENTVAULT__SERVER__HOST=0.0.0.0
AGENTVAULT__SERVER__AUTHGUARD__SCOPE_RESOLVER__TARGET=http://authguard-authz:8081
AGENTVAULT__MGMT__HOST=0.0.0.0
AGENTVAULT__LOGGING__MODE=JSON
AGENTVAULT__STORAGE__PROVIDER=postgres
AGENTVAULT__CACHE__PROVIDER=redis
AGENTVAULT__AGENTVAULT__PAYER__ENABLED=true
AGENTVAULT__AGENTVAULT__PAYER__X402__ENABLED=true
AGENTVAULT__AGENTVAULT__PAYEE__ENABLED=true
AGENTVAULT__AGENTVAULT__PAYEE__X402__ENABLED=true

# Sensitive leaves use their canonical field paths too. The loader keeps these
# values outside the serializable AppConfig object.
HELPER_SECRET_POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
HELPER_SECRET_REDIS_PASSWORD=<REDIS_PASSWORD>
# AgentVault is a Rust/SQLx service, so this is a native PostgreSQL URL rather
# than a jdbc:postgresql:// JVM-driver URL.
AGENTVAULT__STORAGE__POSTGRES__URL=postgresql://agentvault:${HELPER_SECRET_POSTGRES_PASSWORD}@agentvault-postgres:5432/agentvault
AGENTVAULT__CACHE__REDIS__URLS=redis://:${HELPER_SECRET_REDIS_PASSWORD}@agentvault-redis:6379/0
AGENTVAULT__AGENTVAULT__KEY_MANAGEMENT__KEYS__WALLET_KEK_V1=<BASE64URL_32_BYTE_KEY>
AGENTVAULT__AGENTVAULT__RECOVERY_ENCRYPTION__KEYS__RECOVERY_V1=<BASE64URL_32_BYTE_KEY>
AGENTVAULT__AGENTVAULT__APPROVAL__JWT__SIGNING_KEYS__APPROVAL_HS256_V1=<BASE64URL_32_BYTE_KEY>

# This exact value is shared by AuthGuard AuthZ and the AgentVault workload
# adapter. Put the same value in both canonical process namespaces and use at
# least 32 random bytes.
AGENTVAULT__SERVER__AUTHGUARD__DIRECT_CONTEXT_HMAC_KEY=<AT_LEAST_32_RANDOM_BYTES>
AUTHGUARD__AUTHZ__SCOPE_DELIVERY__DIRECT_CONTEXT_HMAC_KEY=<AT_LEAST_32_RANDOM_BYTES>
AUTHGUARD__STORAGE__POSTGRES__PASSWORD=<AUTHGUARD_POSTGRES_PASSWORD>
AUTHGUARD__CACHE__REDIS__PASSWORD=<AUTHGUARD_REDIS_PASSWORD>
AUTHGUARD__AUTHZ__API__TOKEN=<AUTHGUARD_API_TOKEN>
AUTHGUARD__AUTHN__TOKEN__PRIVATE_KEY_B64=<BASE64_PKCS8_RSA_PRIVATE_KEY_PEM>
AUTHGUARD__AUTHN__STANDALONE__ENABLED=true
AUTHGUARD__AUTHN__STANDALONE__CREDENTIAL_ENCRYPTION_KEY=<BASE64_32_BYTE_AES_KEY>
AUTHGUARD__AUTHN__STANDALONE__TOTP__ENABLED=true
AUTHGUARD__AUTHN__STANDALONE__WEBAUTHN__ENABLED=true
AUTHGUARD__AUTHN__STANDALONE__WEBAUTHN__RP_ID=localhost
AUTHGUARD__AUTHN__STANDALONE__WEBAUTHN__RP_ORIGIN=http://localhost:8080

HELPER_INTERNAL_AGENTVAULT_IMAGE=ghcr.io/wl4g/agentvault:0.1.0
HELPER_INTERNAL_AGENTVAULT_WEB_IMAGE=ghcr.io/wl4g/agentvault-web:0.1.0
HELPER_INTERNAL_AUTHGUARD_IMAGE=ghcr.io/wl4g/authguard:1.0.1
HELPER_INTERNAL_AUTHGUARD_WEB_IMAGE=ghcr.io/wl4g/authguard-web:1.0.1
