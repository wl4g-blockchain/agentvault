{
  "name": "@agentvault/sdk",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/agentvault/sdk/agentvault.js",
  "types": "dist/agentvault/sdk/agentvault.d.ts",
  "exports": {
    ".": {
      "types": "./dist/agentvault/sdk/agentvault.d.ts",
      "default": "./dist/agentvault/sdk/agentvault.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "tsx --test tests/agentvault/agentvault_test.ts tests/agentvault/*/*_test.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\""
  },
  "dependencies": {
    "@a2a-js/sdk": "0.3.14",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@x402/core": "2.28.0",
    "@x402/mcp": "2.28.0",
    "express": "^5.1.0",
    "mppx": "0.13.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
