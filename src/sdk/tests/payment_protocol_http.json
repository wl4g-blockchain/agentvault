{
  "schema": "agentvault.sdk.protocol-http.v1",
  "protocols": {
    "x402": {
      "credential_headers": [
        "payment-signature"
      ],
      "challenge_header": "payment-required",
      "evidence_header": "payment-response"
    },
    "mpp": {
      "credential_headers": [
        "payment-authorization",
        "authorization"
      ],
      "challenge_header": "www-authenticate",
      "evidence_header": "payment-receipt",
      "application_authorization": "Bearer app-token",
      "payment_authorization": "Payment credential"
    }
  },
  "matrix": [
    {
      "transport": "http",
      "protocol": "x402",
      "role": "payer"
    },
    {
      "transport": "http",
      "protocol": "x402",
      "role": "payee"
    },
    {
      "transport": "http",
      "protocol": "mpp",
      "role": "payer"
    },
    {
      "transport": "http",
      "protocol": "mpp",
      "role": "payee"
    }
  ]
}
